# 复制为 .env 后用 `set -a; source .env; set +a` 加载。.env 已在 .gitignore 中，不要提交。

# 必填
DEEPSEEK_API_KEY=
# 可选
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

MINI_AGENT_ADDR=127.0.0.1:8080
# 留空 = 不鉴权（仅限本机）。对外暴露时必须设置
MINI_AGENT_TOKEN=
# sqlite | memory
MINI_AGENT_STORE=sqlite
MINI_AGENT_DB=data/mini-agent.db
MINI_AGENT_MAX_TURNS=10
MINI_AGENT_SYSTEM_PROMPT=
